# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# .env.local staat in .gitignore en mag nooit gecommit worden.

# Supabase › Project Settings › Data API › Project URL
SUPABASE_URL=https://jouwprojectref.supabase.co

# Supabase › Project Settings › API Keys › Secret keys
# Deze sleutel omzeilt alle beveiliging. Alleen hier en in Vercel, nooit in de repo,
# nooit doorsturen, en NOOIT in een variabele die met NEXT_PUBLIC_ begint.
SUPABASE_SECRET_KEY=sb_secret_...

# Willekeurige reeks van minstens 32 tekens. Ondertekent de sessiecookies.
# Genereren met:  openssl rand -hex 32
SESSIE_GEHEIM=
